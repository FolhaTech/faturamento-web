# String de conexão do Postgres (Supabase). Use a "Transaction pooler" (porta 6543)
# para deploy em serverless (Vercel/Netlify) — evita esgotar conexões do Postgres.
# Dashboard do projeto: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# String de conexão de um banco Postgres SEPARADO, só para a suíte de testes.
# Obrigatória para rodar `npm test` — os testes fazem TRUNCATE nas tabelas
# (resetDbForTests()) a cada `it`. Nunca aponte para o mesmo projeto do
# DATABASE_URL de produção: já apagamos dados reais assim uma vez. Crie um
# projeto Supabase separado (o free tier serve) e cole a connection string aqui.
TEST_DATABASE_URL="postgresql://postgres.<OUTRO_PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
