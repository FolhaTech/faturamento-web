# String de conexão do Postgres (Supabase). Use a "Transaction pooler" (porta 6543)
# para deploy em serverless (Vercel/Netlify) — evita esgotar conexões do Postgres.
# Dashboard do projeto: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"
